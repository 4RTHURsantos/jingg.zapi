# ── obrigatórios ────────────────────────────────────────────────────────────
# Chave de administrador da API (mínimo 16 caracteres). Gere com: openssl rand -hex 32
ADMIN_API_KEY=troque-por-um-segredo-longo
POSTGRES_PASSWORD=troque-esta-senha
MINIO_ROOT_USER=zapi
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem

# ── rede ────────────────────────────────────────────────────────────────────
# Porta da API no host
API_PORT=3000
# Portas do MinIO no host (S3 e console web)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Endereço pelo qual QUEM CONSOME a API alcança o MinIO. As URLs de mídia enviadas
# nos webhooks são assinadas para este host — em produção use o domínio público.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ── opcionais (valores padrão mostrados) ────────────────────────────────────
# LOG_LEVEL=info
# BAILEYS_LOG_LEVEL=warn
# WORKER_MAX_DEVICES=200          # dispositivos por worker
# LEASE_TTL_MS=30000              # tempo até outro worker assumir um dispositivo órfão
# MARK_ONLINE_ON_CONNECT=false    # true = aparece "online" e o celular para de notificar
# IGNORE_STATUS_BROADCAST=true    # ignora status/stories
# MEDIA_DOWNLOAD=true             # baixa mídia recebida para o MinIO
# MEDIA_MAX_BYTES=104857600
# MEDIA_URL_TTL_SECONDS=604800    # validade das URLs de mídia (máx. 7 dias)
# STICKER_MAX_SECONDS=8           # vídeos viram figurinha animada com no máximo esta duração
# STICKER_FPS=12
# SEND_MAX_ATTEMPTS=5
# SEND_INTERVAL_MS=300            # pausa entre envios do mesmo dispositivo
# SEND_CHECK_NUMBER=true          # confere o número no WhatsApp antes de enviar (resolve o 9º dígito)
# WEBHOOK_MAX_ATTEMPTS=12         # com backoff 5s→1h cobre ~2h30 de indisponibilidade
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_CONCURRENCY=20
# EVENT_RETENTION_DAYS=30         # eventos/entregas concluídos mais antigos são apagados
# MESSAGE_RETENTION_DAYS=0        # 0 = mantém o histórico de mensagens para sempre
